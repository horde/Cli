{
    "name": "horde/cli",
    "description": "Command line interface library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Cli",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-03-23",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/support": "^3 || dev-FRAMEWORK_6_0",
        "horde/translation": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_Cli": "lib/"
        },
        "psr-4": {
            "Horde\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Cli\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}